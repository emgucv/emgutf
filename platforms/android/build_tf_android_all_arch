#!/bin/bash

# Builds everything needed for the MAUI Android nuget package on Ubuntu:
#  1. the native TensorFlow library for the four Android ABIs (arm64, arm, x86, x86_64),
#     with build_tf_android, into lib/android/<abi>/
#  2. the native TensorFlow library for Ubuntu, which Emgu.TF.CodeGen loads to generate Graph.g.cs
#  3. Emgu TF for Ubuntu (build_emgutf), which runs the code generator, builds the managed
#     libraries and nuget packages and, as the Android binaries and the android dotnet workload
#     are present, the Emgu.TF.runtime.maui.android nuget package in platforms/nuget/
#
# This is a full TensorFlow compile for each of the five native builds, so it takes a long time.
# Bazel resumes from its cache, so the script can be run again after a failure.
# Usage: ./build_tf_android_all_arch
# Needs the dependencies installed by apt_install_dependency.sh (and platforms/ubuntu/<version>/apt_install_dependency.sh).

# Stop at the first failing step.
set -e

cd "$(dirname "$0")"

for arch in arm64 arm x86 x86_64; do
    echo "===== Building TensorFlow for Android $arch ====="
    ./build_tf_android $arch
done

# Use the scripts of the running Ubuntu version, or 26.04 if there are none for it.
UBUNTU_VERSION=$(. /etc/os-release && echo "$VERSION_ID")
UBUNTU_DIR=../ubuntu/$UBUNTU_VERSION
if [ ! -d "$UBUNTU_DIR" ]; then
    UBUNTU_DIR=../ubuntu/26.04
fi

echo "===== Building the native TensorFlow library for Ubuntu ($UBUNTU_DIR) ====="
"$UBUNTU_DIR/bazel_build_tf"

echo "===== Building Emgu TF for Ubuntu and the MAUI Android nuget package ($UBUNTU_DIR) ====="
"$UBUNTU_DIR/build_emgutf" -j"$(nproc)"

echo "===== Done. The nuget packages are in platforms/nuget ====="
ls -l ../nuget/*.nupkg
